{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Remote Attach",
            "type": "python",
            "preLaunchTask": "run-debug-server",
            "justMyCode": false,
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/defensegan"
                }
            ]
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "args": [
                "--cfg",
                "output/gans/mnist-long",
                "--results_dir",
                "debugging",
                "--bb_model",
                "A",
                "--sub_model",
                "B",
                "--fgsm_eps",
                "0.0",
                "--attack_type",
                "mim",
                "--debug",
                "True",
                "--debug_dir",
                "debug/debugging",
                "--nb_epochs",
                "1",
                "--nb_epochs_s",
                "1",
                "--data_aug",
                "1"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Docker: Python - General",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "python": {
                "pathMappings": [
                    {
                        "localRoot": "${workspaceFolder}",
                        "remoteRoot": "/defensegan"
                    }
                ],
                "projectType": "general",
                "args": [
                    "--cfg",
                    "output/gans/mnist-long",
                    "--results_dir",
                    "debugging",
                    "--bb_model",
                    "A",
                    "--sub_model",
                    "B",
                    "--fgsm_eps",
                    "0.0",
                    "--attack_type",
                    "mim",
                    "--debug",
                    "True",
                    "--debug_dir",
                    "debug/debugging",
                    "--nb_epochs",
                    "1",
                    "--nb_epochs_s",
                    "1",
                    "--data_aug",
                    "1"
                ]
            }
        }
    ]
}